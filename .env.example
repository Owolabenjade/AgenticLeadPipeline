# Server (fill in after Railway deployment)
WEBHOOK_BASE_URL=https://your-app.up.railway.app

# Market settings — change these three to redeploy in any country
PHONE_DEFAULT_COUNTRY=NG
LOCALE=en-NG
CURRENCY_SYMBOL=NGN

# HubSpot CRM
HUBSPOT_ACCESS_TOKEN=your-hubspot-pat
HUBSPOT_PORTAL_ID=your-portal-id
HUBSPOT_SALES_OWNER_ID=your-owner-id
MANUAL_REVIEW_OWNER_EMAIL=your-email@example.com

# Groq
GROQ_API_KEY=your-groq-api-key

# VAPI
VAPI_API_KEY=your-vapi-api-key
VAPI_PHONE_NUMBER_ID=your-vapi-phone-id

# Upstash Redis
UPSTASH_REDIS_URL=https://your-redis.upstash.io
UPSTASH_REDIS_TOKEN=your-redis-token

# Brevo (replaces Mailgun)
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=your-sender@example.com
BREVO_SENDER_NAME=Your Company Name

# Slack
SLACK_WEBHOOK_HOT_LEADS=https://hooks.slack.com/services/xxx
SLACK_WEBHOOK_SYSTEM_ALERTS=https://hooks.slack.com/services/xxx
SLACK_SALES_HEAD_ID=UXXXXXXXXXX
